<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memory Store</title>
    <!-- Linked CSS directly assuming both index.html and index.css are in the same folder -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <img src="https://unsplash.com" alt="logo here">
        <nav>
            <ol>
                <li><a href="#">Home</a></li>
                <li><a href="#">Products</a></li>
                <li><a href="#">Cart</a></li>
                <li><a href="#">About</a></li>
                <li><a href="#">Contact</a></li>
                <li><a href="#">Login</a></li>
            </ol>
        </nav>
    </header>
    <main>
        <section id="title-container">
            <!-- Fallback background image since local video won't load from the internet -->
            <img src="https://unsplash.com" alt="Anime Background" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; z-index:-1;">
            <h1>Welcome to Anime Store!</h1>
        </section>

        <section id="products-container">
            <!-- Card 1 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Ash's Cap">
                </div>
                <div class="card-body">
                    <h3>Product: Ash's Cap</h3>
                    <h3>Price: 499</h3>
                    <h3>Rating: 4.4/5</h3>
                    <br>
                    <h3>The Winner's Cap!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Death Note">
                </div>
                <div class="card-body">
                    <h3>Product: Death Note</h3>
                    <h3>Price: 1399</h3>
                    <h3>Rating: 4.3/5</h3>
                    <br>
                    <h3>Do you like writing names!?</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Red Scarf">
                </div>
                <div class="card-body">
                    <h3>Product: Red Scarf</h3>
                    <h3>Price: 544</h3>
                    <h3>Rating: 5/5</h3>
                    <br>
                    <h3>Stock Unavailable!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="T-Shirt">
                </div>
                <div class="card-body">
                    <h3>Product: T-Shirt</h3>
                    <h3>Price: 599</h3>
                    <h3>Rating: 4.3/5</h3>
                    <br>
                    <h3>I am not Zenin, Took my wife's name!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Mouse Pad">
                </div>
                <div class="card-body">
                    <h3>Product: Mouse Pad</h3>
                    <h3>Price: 399</h3>
                    <h3>Rating: 4.9/5</h3>
                    <br>
                    <h3>Make your Mouse "Ultra Instinct"</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Anya-Man">
                </div>
                <div class="card-body">
                    <h3>Product: Anya-Man</h3>
                    <h3>Price: 399</h3>
                    <h3>Rating: 4.7/5</h3>
                    <br>
                    <h3>The Honoured One!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 7 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="The Mask">
                </div>
                <div class="card-body">
                    <h3>Product: The Mask</h3>
                    <h3>Price: 499</h3>
                    <h3>Rating: 4.9/5</h3>
                    <br>
                    <h3>Hide your emotions with this!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

            <!-- Card 8 -->
            <div class="card">
                <div class="card-header">
                    <img src="https://unsplash.com" alt="Mini-Waguri">
                </div>
                <div class="card-body">
                    <h3>Product: Mini-Waguri</h3>
                    <h3>Price: 399</h3>
                    <h3>Rating: 4.4/5</h3>
                    <br>
                    <h3>Cake Loverss all around!</h3>
                    <br>
                </div>
                <div class="card-footer">
                    <button>Buy</button>
                    <button>Add to Cart</button>
                </div>
            </div>

        </section>
    </main>
</body>
</html>







































